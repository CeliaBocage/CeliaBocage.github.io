# Variables d'environnement : à définir dans Vercel (Settings → Environment Variables).
# NE JAMAIS committer les vraies valeurs. Copier ce fichier en .env pour du local.

# Base de données Turso (libSQL)
TURSO_DB_URL=libsql://votre-base.turso.io
TURSO_DB_TOKEN=YOUR_TURSO_TOKEN_HERE

# Mot de passe de l'espace admin (/navigation/admin.html).
# Sans cette variable, l'admin est désactivé et toute écriture est refusée.
# Choisir un mot de passe long et unique.
ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD_HERE

# --- Alerte email des messages de contact (facultatif) ---------------------
# Sans ces variables, le formulaire de contact fonctionne quand même : les
# messages sont enregistrés et visibles dans /navigation/admin.html, mais
# aucun email n'est expédié (état « disabled » dans l'admin).
#
# Clé API Resend : https://resend.com (l'offre gratuite suffit largement ici)
RESEND_API_KEY=YOUR_RESEND_KEY_HERE
# Adresse qui reçoit les messages
CONTACT_TO_EMAIL=vous@example.com
# Expéditeur : le domaine doit être vérifié dans Resend.
# Pour tester sans domaine, laisser vide : le code utilise onboarding@resend.dev
MAIL_FROM=
